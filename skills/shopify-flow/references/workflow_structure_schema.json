{
  "type": "object",
  "properties": {
    "__metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "enum": [
            0.1
          ]
        }
      },
      "required": [
        "version"
      ]
    },
    "root": {
      "type": "object",
      "properties": {
        "workflow_name": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "task_type": {
                "type": "string",
                "enum": [
                  "TRIGGER",
                  "CONDITION",
                  "ACTION",
                  "WAIT",
                  "FOREACH"
                ]
              },
              "config_field_values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "if": {
                    "properties": {
                      "config_field_id": {
                        "const": "condition"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "config_field_id": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Must be a non-empty string when config_field_id is 'condition'"
                      }
                    },
                    "required": [
                      "config_field_id",
                      "value"
                    ]
                  },
                  "else": {
                    "properties": {
                      "config_field_id": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "config_field_id",
                      "value"
                    ]
                  }
                }
              },
              "task_id": {
                "type": "string"
              }
            },
            "required": [
              "step_id",
              "task_type",
              "config_field_values",
              "task_id"
            ]
          }
        },
        "links": {
          "type": "array"
        },
        "patched_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              },
              "handle": {
                "type": "string"
              },
              "patched_type": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "arguments",
              "handle",
              "patched_type"
            ]
          }
        }
      },
      "required": [
        "workflow_name",
        "steps",
        "links",
        "patched_fields"
      ]
    }
  },
  "required": [
    "__metadata",
    "root"
  ]
}
